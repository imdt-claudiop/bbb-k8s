# API-Mate static UI (upstream https://github.com/mconf/api-mate @ d058fb77e11113c39ae84b2e9c6831a794cf9bbe, gh-pages).
# Not a BBB package: bbb-conf only links to https://mconf.github.io/api-mate/.
# Trailing-slash location + alias closes the nginx off-by-slash alias traversal
# (a bare "location /api-mate { alias /usr/share/api-mate/; }" would serve /api-mate../<x>).
location = /api-mate { return 301 /api-mate/; }
location /api-mate/ {
    alias /usr/share/api-mate/;
    index index.html;
    try_files $uri $uri/ =404;
}
